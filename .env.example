# Copy to .env. Keys stay on the server and must never be committed.
TYPESAFE_API_KEY=
# Alternative access to the same Jev model (no TypeSafe account required).
OPENROUTER_API_KEY=
JEV_SCOUT_MODEL=jev-latest
JEV_SCOUT_DATA_DIR=runtime
# Optional actual input-token price for your account, in USD per million.
# Leave blank to display cost as unavailable rather than inventing a value.
JEV_SCOUT_PRICE_PER_MILLION_INPUT=
JEV_SCOUT_HOST=127.0.0.1
JEV_SCOUT_PORT=8765
# Optional local Qwen or another OpenAI-compatible provider.
JEV_SCOUT_LLM_BASE_URL=
JEV_SCOUT_LLM_API_KEY=
JEV_SCOUT_LLM_MODEL=qwen3-4b
JEV_SCOUT_LLM_PRICE_PER_MILLION_INPUT=
# For scripts/start_local.ps1 -WithLocalModel; an existing model directory.
JEV_SCOUT_LOCAL_MODEL_PATH=
